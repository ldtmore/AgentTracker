{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentTrackerIsland",
  "version": "0.1.0",
  "identifier": "com.agenttrackerisland.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "AgentTrackerIsland",
        "width": 360,
        "height": 48,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "AgentTrackerIsland 设置",
        "url": "index.html#settings",
        "width": 800,
        "height": 600,
        "minWidth": 520,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "report",
        "title": "AgentTrackerIsland 报表",
        "url": "index.html#report",
        "width": 940,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
